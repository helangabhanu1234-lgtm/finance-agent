# Copy to .env to override defaults (never commit .env)
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
AGENT_MAX_STEPS=8
# FINANCE_OFFLINE=1   # use offline exchange rates only
OLLAMA_TIMEOUT=600        # seconds to wait for ONE model reply (slow CPU-only PCs may need 1-3 min per step)
OLLAMA_KEEP_ALIVE=30m     # keep the model loaded between questions
